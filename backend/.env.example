# Server
PORT=4000
NODE_ENV=development

# Supabase Database & Auth
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# Storage Buckets (Supabase Storage)
SUPABASE_UPLOADS_BUCKET=jewelai-uploads
SUPABASE_GENERATED_BUCKET=jewelai-generated
SUPABASE_PAYMENTS_BUCKET=jewelai-payments
SUPABASE_PUBLIC_BUCKET=jewelai-public
STORAGE_PROVIDER=supabase

# UPI Payment Configuration
UPI_ID=jewelai@upi
UPI_QR_CODE_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/object/public/jewelai-public/upi-qr.png

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=JEWELAI <noreply@jewelai.com>

# Google Gemini AI Model
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Client URLs
USER_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000,http://localhost:3001

# JWT Secrets
JWT_SECRET=jewelai-secret-jwt-key-2026-production-token
JWT_EXPIRES_IN=7d

# Upload Constraints (Bytes)
MAX_UPLOAD_MB=8
MAX_FILE_SIZE=8388608
MAX_PAYMENT_SCREENSHOT_SIZE=5242880
